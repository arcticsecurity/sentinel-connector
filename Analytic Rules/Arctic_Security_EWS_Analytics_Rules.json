            "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/33646af6-3173-4b8b-94e8-b98e297a2c31')]",
            "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
            "kind": "Scheduled",
            "apiVersion": "2022-11-01-preview",
            "properties": {
                "displayName": "EWS Shared Resource",
                "description": "",
                "severity": "Informational",
                "enabled": true,
                "query": "ArcticSecurityEws_CL | where shared_resource == \"yes\"",
                "queryFrequency": "PT1H",
                "queryPeriod": "PT1H",
                "triggerOperator": "GreaterThan",
                "triggerThreshold": 0,
                "suppressionDuration": "PT5H",
